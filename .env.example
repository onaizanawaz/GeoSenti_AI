# Copy to .env and fill in real values. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:hooria.1234@localhost:5432/geoflow
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ARTIFACT_ROOT=data/artifacts
MAX_DOWNLOAD_BYTES=33554432

# List fields are parsed as JSON by pydantic-settings — brackets and quotes required.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]



# Phase 3 — Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_KEY_PATH=keys/gee-service-account.json
GEE_PROJECT=