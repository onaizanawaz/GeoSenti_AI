# Copy to .env and fill in real values. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/geoflow_portal
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ARTIFACT_ROOT=data/artifacts
MAX_DOWNLOAD_BYTES=33554432

# List fields are parsed as JSON by pydantic-settings — brackets and quotes required.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Phase 6 — LLM planner
# PLANNER_MODE: static (no LLM) | llm | dummy
PLANNER_MODE=static
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_REPAIRS=2

# Ollama - local, no key. Run `ollama serve`, then `ollama pull <model>` and
# set OLLAMA_MODEL to exactly what `ollama list` shows.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# xAI / Grok - key from https://console.x.ai. Confirm the current model name
# in the xAI docs before relying on the default below.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# Phase 5 - execution
# sequential (safe under --pool=solo) | parallel (prefork worker, -c > 1)
EXECUTION_STRATEGY=sequential
MAX_PARALLEL_NODES=4
ORCHESTRATOR_POLL_SECONDS=2
RUN_TIMEOUT_SECONDS=3600

# Phase 3 — Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_KEY_PATH=keys/gee-service-account.json
GEE_PROJECT=